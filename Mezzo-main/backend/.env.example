# ==============================================
# Mezzo Backend Environment Variables
# ==============================================
# Copy this file to .env and fill in actual values
# DO NOT commit .env to version control

# === Server ===
HTTP_PORT=4000
WS_PORT=4001
HOST=0.0.0.0
SERVER_URL=192.168.254.1

# === CORS ===
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# === MQTT (PTT) ===
MQTT_BROKER_URL=mqtt://118.163.141.80:1688
MQTT_CLIENT_PREFIX=mezzo-ptt-bridge

# === BWC Stream ===
BWC_STREAM_HOST=118.163.141.80
BWC_STREAM_PORT=80
BWC_STREAM_AUTH=QWRtaW46MTIzNA==

# === TAK Server ===
TAK_ENABLED=false
TAK_HOST=192.168.254.1
TAK_PORT=8087
TAK_USE_TLS=false
TAK_RECONNECT_INTERVAL=5000
TAK_HEARTBEAT_INTERVAL=30000

# === RTSP Streams ===
STREAM_ENABLED=true
STREAM_MAX=10
STREAM_TIMEOUT=300000

# === Logging ===
# Levels: error, warn, info, debug
LOG_LEVEL=info
NODE_ENV=development

# === Auth (Cognito) ===
# Leave empty to disable authentication (dev mode)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-northeast-1

# === Database (PostgreSQL / RDS) ===
# Leave empty to disable database features (dev mode)
DATABASE_URL=
# DATABASE_URL=postgresql://mezzo:password@localhost:5432/mezzo

# === Redis (ElastiCache) ===
# Leave empty to disable Redis features (dev mode)
REDIS_URL=
# REDIS_URL=redis://localhost:6379

# === GPS Batching ===
GPS_BATCH_INTERVAL=5000
GPS_BATCH_SIZE=200
